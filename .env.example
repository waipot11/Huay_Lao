# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LINE_CHANNEL_ACCESS_TOKEN: Long-lived Channel Access Token from LINE Developers Console (Messaging API tab).
# Set this in AI Studio Settings > Secrets / Environment Variables for persistent LINE alerts across restarts.
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN"

# LINE_USER_ID: Your LINE User ID (starts with U..., 33 characters) from LINE Developers Console (Basic settings tab).
LINE_USER_ID="YOUR_LINE_USER_ID"

# LINE_SEND_MODE: Optional delivery mode ("push" for personal Push Message, or "broadcast" for all OA followers).
LINE_SEND_MODE="push"

# LINE_ALERT_TIME: Optional Bangkok time (HH:mm, 24h) for auto-alert on Mon/Wed/Fri (default: 18:30).
LINE_ALERT_TIME="18:30"

# TELEGRAM_BOT_TOKEN: Bot Token from @BotFather on Telegram.
# Set in AI Studio Settings > Secrets / Environment Variables for persistent Telegram group notifications.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# TELEGRAM_CHAT_ID: Target Telegram Group / Supergroup / Channel Chat ID (e.g. -1001234567890, comma-separated for multiple groups).
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_GROUP_CHAT_ID"

# TELEGRAM_ALERT_TIME: Optional Bangkok time (HH:mm, 24h) for auto-alert on Mon/Wed/Fri (default: 18:30).
TELEGRAM_ALERT_TIME="18:30"


